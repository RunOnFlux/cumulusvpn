source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
# Floor raised from the RN template's '>= 6.1.7.5', '!= 7.1.0' to clear
# GHSA-cg4j-q9v8-6v38, GHSA-89vf-4333-qx8v and GHSA-2j26-frm8-cmj9 (fixed in
# 7.2.3.1). activesupport 7.2 needs Ruby >= 3.1.
gem 'activesupport', '>= 7.2.3.1'
gem 'xcodeproj', '< 1.29.0'
# The RN template caps this at '< 1.3.4' because 1.3.5 stopped requiring
# 'logger', which activesupport < 7.1 relied on. activesupport >= 7.1 requires
# 'logger' itself, so the cap is obsolete here; upstream React Native lifted it
# the same way (react/react-native#57355). 1.3.7 fixes GHSA-h8w8-99g7-qmvj,
# GHSA-wv3x-4vxv-whpp and GHSA-6wx8-w4f5-wwcr.
gem 'concurrent-ruby', '>= 1.3.7'

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
