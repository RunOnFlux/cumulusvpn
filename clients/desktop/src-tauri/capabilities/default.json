{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core capability set for the CumulusVPN tray window.",
  "windows": [
    "main",
    "popover"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "zel:*"
        },
        {
          "url": "ssp:*"
        }
      ]
    },
    "notification:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/wireguard-go",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*:51821/*"
        },
        {
          "url": "http://*:16127/*"
        },
        {
          "url": "https://api.runonflux.io/*"
        },
        {
          "url": "https://pay.cumulusvpn.com/*"
        },
        {
          "url": "https://dashboard.cumulusvpn.com/*"
        }
      ]
    }
  ]
}
