{
  "name": "@cumulusvpn/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "CumulusVPN payments bridge — converts verified fiat payments (Stripe, Apple IAP, Google Play Billing) into on-chain FLUX payments carrying the user's CVPN1 memo. Standalone (NOT a root workspace); runs on operator infra, never as a Flux app.",
  "type": "module",
  "packageManager": "yarn@4.5.0",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md}\""
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@noble/hashes": "2.4.0",
    "@runonflux/utxo-lib": "1.0.5",
    "@scure/base": "2.4.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "google-auth-library": "11.3.0",
    "googleapis": "185.0.0",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
