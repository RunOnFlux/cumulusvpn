# CumulusVPN payments bridge — environment reference.
# Copy to .env (never commit) or inject via the container runtime.
# A rail is ENABLED by the presence of its lead variable (STRIPE_SECRET_KEY /
# APPLE_BUNDLE_ID / GOOGLE_PACKAGE_NAME); at least one rail is required.

# --- Core ---
PORT=8080
HOST=0.0.0.0
DB_PATH=/data/bridge.db
# The fleet's premium payment address + price (must match CVPN_PAYMENT_ADDRESS
# / CVPN_PRICE_FLUX in the gateway specs — deploy/specs/onchain/*).
PAYMENT_ADDRESS=t3disq3aZz8K3RLZL9zfkpP2UWNVV3hq4vZ
PRICE_FLUX=20
# Treasury wallet private key (WIF). Holds the FLUX that settles fiat sales.
# NEVER logged, never exposed by any endpoint. Rotate by sweeping to a new key.
TREASURY_WIF=
# Flat network fee per payment tx.
FEE_FLUX=0.0001
EXPLORER_URL=https://explorer.runonflux.io/api
EXPLORER_FALLBACK_URL=https://api.runonflux.io
# Bearer token for GET /internal/treasury.
ADMIN_TOKEN=
# Optional Discord/Slack-compatible webhook for operator alerts.
ALERT_WEBHOOK_URL=
# Alert when the treasury drops below this many FLUX.
MIN_TREASURY_FLUX=200
# Allow CREATING day-granular (non-30-multiple) vouchers. Keep false until
# the whole gateway fleet runs the pro-rata day rule (docs/04) — old
# gateways ignore sub-price payments, so an early day-voucher settlement
# would grant nothing on them. 30-multiple (whole-month) vouchers always work.
DAY_GRANTS_ENABLED=false

# --- Stripe rail (web/desktop card + web Apple/Google Pay) ---
# NOTE: Apple Pay and Google Pay are NOT configured here. We create hosted
# Checkout Sessions without payment_method_types, so the wallets shown come
# from Stripe Dashboard → Settings → Payments → Payment methods. Enable Apple
# Pay and Google Pay there or checkout silently ships card-only. (Stripe-hosted
# Checkout needs no domain registration for Apple Pay; that is only for the
# embedded Payment Element.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids for the $1.99/mo and $14.99/yr subscription prices.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# {CHECKOUT_SESSION_ID} is substituted by Stripe on redirect. The placeholder
# is REQUIRED (config fails fast without it): the web app only shows the
# activation panel — and only preserves a desktop ?code= hand-off — when the
# session id comes back inside the hash query.
STRIPE_SUCCESS_URL=https://vpn.cumulusvpn.com/#/upgrade?session={CHECKOUT_SESSION_ID}
# canceled=1 keeps a desktop ?code= hand-off alive across a canceled checkout
# (a plain #/upgrade visit deliberately clears the override).
STRIPE_CANCEL_URL=https://vpn.cumulusvpn.com/#/upgrade?canceled=1
# Where Stripe's billing portal returns the customer to after they cancel /
# change card / switch plan. Optional — defaults to STRIPE_CANCEL_URL.
STRIPE_PORTAL_RETURN_URL=https://vpn.cumulusvpn.com/#/upgrade
# Whether TEST-mode Stripe invoices settle REAL chain payments. Keep false:
# with sk_test_ set, one 4242 checkout would otherwise broadcast a real
# 20-FLUX tx, and a testing session drains the treasury. Test invoices are
# still verified and bound, just not settled (same as APPLE_SANDBOX_GRANTS /
# GOOGLE_TEST_GRANTS).
STRIPE_TEST_GRANTS=false

# --- Apple IAP rail ---
APPLE_BUNDLE_ID=
# Numeric App Store id (required for Production verification).
APPLE_APP_ID=
APPLE_ENVIRONMENT=Production
# Accept sandbox-signed payloads too (TestFlight / App Review). Default true.
APPLE_ALLOW_SANDBOX=true
# Whether sandbox purchases settle REAL chain payments. Keep false: the
# sandbox renewal clock is accelerated and would drain the treasury.
APPLE_SANDBOX_GRANTS=false
# Directory of Apple root certs (defaults to the vendored bridge/certs).
#APPLE_ROOT_CA_DIR=
APPLE_PRODUCT_MONTHLY=cvpn.premium.monthly
APPLE_PRODUCT_ANNUAL=cvpn.premium.annual

# --- Google Play rail ---
GOOGLE_PACKAGE_NAME=
# Inline service-account JSON with androidpublisher access.
GOOGLE_SERVICE_ACCOUNT_JSON=
# OIDC audience configured on the Pub/Sub push subscription (this endpoint URL).
GOOGLE_RTDN_AUDIENCE=
# Service-account email the Pub/Sub push authenticates as.
GOOGLE_RTDN_EMAIL=
GOOGLE_BASE_PLAN_MONTHLY=premium-monthly
GOOGLE_BASE_PLAN_ANNUAL=premium-annual
# Whether license-tester purchases settle real chain payments. Keep false.
GOOGLE_TEST_GRANTS=false
